{
    "name": "danog/php-rtc-sctp",
    "type": "library",
    "description": "SCTP for PHP WebRTC data channels, ported to Amp v3 fibers and timers. MadelineProto's PHP 8.2+ fork is part of the modular danog/php-rtc stack.",
    "keywords": [
        "webrtc",
        "sctp",
        "datachannel"
    ],
    "homepage": "https://github.com/danog/php-rtc-sctp",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community"
        },
        {
            "name": "Daniil Gentili",
            "email": "daniil@daniil.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "amphp/amp": "^3.1",
        "danog/php-rtc-exception": "^1.0",
        "danog/php-rtc-sdp": "^1.0",
        "danog/php-rtc-stats": "^1.0",
        "danog/php-rtc-ice": "^1.0",
        "danog/php-rtc-datachannel": "^1.0",
        "symfony/polyfill-mbstring": "^1.32"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "mockery/mockery": "^1.6",
        "symfony/phpunit-bridge": "7.3.x-dev",
        "dg/bypass-finals": "dev-master",
        "bamarni/composer-bin-plugin": "^1.9"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\SCTP\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\SCTP\\": "tests"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "post-install-cmd": [
            "@composer bin all install --ansi"
        ],
        "post-update-cmd": [
            "@composer bin all update --ansi"
        ]
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
